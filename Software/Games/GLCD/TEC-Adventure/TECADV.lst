20A6   53 74 61 74 69 6F 6E 66 61 6C 6C 00 DB   "Stationfall",0   
20B2   F2 2B                  DW   SETGAME   
20B4   44 65 61 64 6C 69 6E 65 00 DB   "Deadline",0   
20BD   F2 2B                  DW   SETGAME   
20BF   48 69 74 63 68 68 69 6B 65 72 73 20 47 75 69 64 65 00 DB   "Hitchhikers Guide",0   
20D1   F2 2B                  DW   SETGAME   
20D3   48 6F 6C 6C 79 77 6F 6F 64 20 48 69 6A 69 6E 78 00 DB   "Hollywood Hijinx",0   
