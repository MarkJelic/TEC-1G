2DF7   56                     LD   D,(HL)   ;ADDRESS MSB
2DF8   2A 3C 3D               LD   HL,(ARG1)   ;FIRST ARG
2DFB   EB                     EX   DE,HL   ;HL ^ TABLE ADDRESS OF ROUTINE
2DFC                             ;			 DE <= FIRST ARG
2DFC   3A 44 3D               LD   A,(ARGCNT)   ;B <= ARG COUNT
2DFF   47                     LD   B,A   
2E00   E9                     JP   (HL)   ;GO TO IT
2E01                             ; 
2E01                             ; HANDLE A 0-OP
2E01                             ; 
2E01   D6 B0        OP0:      SUB   176   ;ADJUST VALUE
2E03   FE 0E                  CP   OP0M   ;IS IT A LEGAL 0-OP?
2E05   D2 40 31               JP   NC,BADOP   ;  NO.
2E08   21 75 2F               LD   HL,OP0T   ;  YES.  HL ^ 0-OP TABLE
2E0B   C3 F0 2D               JP   OPDSPH   ;DISPATCH IT
2E0E                             ; 
2E0E                             ; HANDLE A 1-OP
2E0E                             ; 
2E0E   E6 30        OP1:      AND   30H   ;1 OP, ISOLATE BITS 5,4
2E10   CC 6E 2E               CALL   Z,GETLNG   ;00=LONG IMMEDIATE
2E13   FE 10                  CP   10H   
2E15   CC 65 2E               CALL   Z,GETSHT   ;01=SHORT IMMEDIATE
2E18   FE 20                  CP   20H   
2E1A   CC 7B 2E               CALL   Z,GETVAR   ;10=VARIABLE
2E1D   3E 01                  LD   A,1   
2E1F   32 44 3D               LD   (ARGCNT),A   ;1 ARG
2E22   22 3C 3D               LD   (ARG1),HL   ;STORE IT
2E25   3A 45 3D               LD   A,(OPCODE)   ;RESTORE OPCODE
2E28   E6 CF                  AND   0CFH   ;(NOT 30H) TURN OFF MODE BITS
2E2A   D6 80                  SUB   128   ;ADJUST VALUE
2E2C   FE 10                  CP   OP1M   ;LEGAL 1-OP?
2E2E   D2 40 31               JP   NC,BADOP   ;  NO.
2E31   21 91 2F               LD   HL,OP1T   ;  YES.  HL ^ 1-OP TABLE
2E34   C3 F0 2D               JP   OPDSPH   ;DISPATCH IT
2E37                             ; 
2E37                             ; HANDLE A 2-OP
2E37                             ; 
2E37   E6 40        OP2:      AND   40H   ;ISOLATE 1ST. ARG BIT
2E39   C4 7B 2E               CALL   NZ,GETVAR   ;1=VARIABLE
2E3C   CC 65 2E               CALL   Z,GETSHT   ;0=SHORT IMMEDIATE
2E3F   22 3C 3D               LD   (ARG1),HL   ;STORE ARG1
2E42   3A 45 3D               LD   A,(OPCODE)   ;RESTORE OPCODE
2E45   E6 20                  AND   20H   ;ISOLATE 2ND. ARG BIT
2E47   C4 7B 2E               CALL   NZ,GETVAR   ;1=VARIABLE
2E4A   CC 65 2E               CALL   Z,GETSHT   ;2=SHORT IMMEDIATE
2E4D   22 3E 3D               LD   (ARG2),HL   ;STORE ARG 2
2E50   3E 02                  LD   A,2   
2E52   32 44 3D               LD   (ARGCNT),A   ;TWO ARGS
2E55   3A 45 3D               LD   A,(OPCODE)   ;RESTORE OPCODE
2E58   E6 1F        OP2EX:    AND   1FH   ;(NOT 0E0H) TURN OFF MODE BITS
2E5A   FE 19                  CP   OP2M   ;LEGAL 2-OP?
2E5C   D2 40 31               JP   NC,BADOP   ;  NO.
2E5F   21 B1 2F               LD   HL,OP2T   ;  YES.  HL ^ 2-OP TABLE
2E62   C3 F0 2D               JP   OPDSPH   ;DISPATCH IT
2E65                             ; 
2E65                             ;*************************************
2E65                             ;* OPCODE ARGUMENT FETCH SUBROUTINES *
2E65                             ;*************************************
2E65                             ; 
2E65                             ; -----------------------
2E65                             ; FETCH A SHORT IMMEDIATE
2E65                             ; -----------------------
2E65   F5           GETSHT:   PUSH   AF   ;SAVE OPCODE
2E66   CD DB 38               CALL   NEXTPC   ;GET NEXT ZBYTE
2E69   6F                     LD   L,A   ;MAKING IT THE LSB OF ARGUMENT
2E6A   26 00                  LD   H,0   ;MSB IS 0
2E6C   F1                     POP   AF   ;RESTORE OPCODE
2E6D   C9                     RET      
2E6E                             ; ----------------------
2E6E                             ; FETCH A LONG IMMEDIATE
2E6E                             ; ----------------------
2E6E   F5           GETLNG:   PUSH   AF   ;SAVE OPCODE
2E6F   CD DB 38               CALL   NEXTPC   ;GET NEXT ZBYTE
2E72   67                     LD   H,A   ;MAKING IT THE MSB OF ARGUMENT
2E73   E5                     PUSH   HL   ;SAVE IT ON THE STACK
2E74   CD DB 38               CALL   NEXTPC   ;GET NEXT ZBYTE
2E77   E1                     POP   HL   ;RESTORE MSB OF ARGUMENT
2E78   6F                     LD   L,A   ;AND FILL IN LSB OF ARGUMENT
2E79   F1                     POP   AF   ;RESTORE OPCODE
2E7A   C9                     RET      
2E7B                             ; ----------------
2E7B                             ; FETCH A VARIABLE
2E7B                             ; ----------------
2E7B   F5           GETVAR:   PUSH   AF   ;GET VAR, 0FIRST FIND TYPE
2E7C   CD DB 38               CALL   NEXTPC   
2E7F   B7                     OR   A   
2E80   CA A3 2E               JP   Z,GETVRS   ;FROM STACK
2E83   FE 10        GETVR1:   CP   16   
2E85   D2 97 2E               JP   NC,GETVRG   ;GLOBAL
2E88   3D           GETVRL:   DEC   A   ;LOCAL
2E89   87                     ADD   A,A   
2E8A   5F                     LD   E,A   
2E8B   16 00                  LD   D,0   
2E8D   21 08 3D               LD   HL,LOCALS   
2E90   19           GETVL1:   ADD   HL,DE   ;POINTER TO VARIABLE
2E91   56                     LD   D,(HL)   
2E92   23                     INC   HL   
2E93   5E                     LD   E,(HL)   
2E94   EB                     EX   DE,HL   ;RETURN VALUE IN HL
2E95   F1                     POP   AF   
2E96   C9                     RET      
2E97                             ; 
2E97   D6 10        GETVRG:   SUB   16   
2E99   5F                     LD   E,A   ;GET GLOBAL
2E9A   16 00                  LD   D,0   
2E9C   2A 46 3D               LD   HL,(GLOBAL)   
2E9F   19                     ADD   HL,DE   ;PRE ADD SO IT GETS DONE TWICE
2EA0   C3 90 2E               JP   GETVL1   
2EA3                             ; 
2EA3   CD C6 38     GETVRS:   CALL   POPSTK   ;VAR FROM STACK
2EA6   F1                     POP   AF   
2EA7   C9                     RET      
2EA8                             ; 
2EA8                             ;*********************
2EA8                             ;* MISC. SUBROUTINES *
2EA8                             ;*********************
2EA8   AF           RET0:     XOR   A   ;RETURN 0
2EA9   6F           PUTBYT:   LD   L,A   
2EAA   26 00                  LD   H,0   
2EAC   CD B2 2E     PUTVAL:   CALL   PUTVLC   ;STORE VALUE
2EAF   C3 91 2D               JP   MLOOP   
2EB2                             ; 
2EB2   E5           PUTVLC:   PUSH   HL   ;SAVE VALUE
2EB3   CD DB 38               CALL   NEXTPC   ;GET TYPE
2EB6   E1                     POP   HL   
2EB7   B7           PUTVR1:   OR   A   
2EB8   CA AD 38               JP   Z,PSHSTK   ;SAVE ON STACK AND RETURN
2EBB   EB                     EX   DE,HL   ;VALUE IN DE
2EBC   FE 10                  CP   16   
2EBE   D2 CE 2E               JP   NC,PUTVLG   ;GLOBAL
2EC1   3D           PUTVLL:   DEC   A   ;LOCAL
2EC2   87                     ADD   A,A   
2EC3   4F                     LD   C,A   
2EC4   06 00                  LD   B,0   
2EC6   21 08 3D               LD   HL,LOCALS   
2EC9   09           PUTVL1:   ADD   HL,BC   ;COMPUTE ADDRESS
2ECA   72                     LD   (HL),D   
2ECB   23                     INC   HL   
2ECC   73                     LD   (HL),E   
2ECD   C9                     RET      
2ECE                             ; 
2ECE   D6 10        PUTVLG:   SUB   16   
2ED0   4F                     LD   C,A   ;STORE GLOBAL
2ED1   06 00                  LD   B,0   
2ED3   2A 46 3D               LD   HL,(GLOBAL)   ;GLOBAL POINTER
2ED6   09                     ADD   HL,BC   ;PRE ADD
2ED7   C3 C9 2E               JP   PUTVL1   
2EDA                             ; 
2EDA                             ;*********************
2EDA                             ;* DATA MANIPULATION *
2EDA                             ;*********************
2EDA                             ; 
2EDA                             ; -----------------
2EDA                             ; RECALL A VARIABLE
2EDA                             ; -----------------
2EDA   F5           VARGET:   PUSH   AF   ;SAVE OPCODE
2EDB   B7                     OR   A   ;IF NON-ZERO
2EDC   C2 83 2E               JP   NZ,GETVR1   ; THEN GET A VARIABLE FROM LOCAL OR GLOBAL TABLE
2EDF                             ;			 ELSE TAKE VAR OFF STACK
2EDF   F1           VARGTS:   POP   AF   ;RESTORE OPCODE
2EE0   CD C6 38               CALL   POPSTK   ;POP A WORD FROM ZSTACK
2EE3   C3 AD 38               JP   PSHSTK   ;PUT IT BACK AND RETURN THE VALUE IN HL
2EE6                             ; ----------------
2EE6                             ; STORE A VARIABLE
2EE6                             ; ----------------
2EE6   B7           VARPUT:   OR   A   ;IF NON-ZERO
2EE7   C2 B7 2E               JP   NZ,PUTVR1   ;  THEN PUT A VARIABLE IN LOCAL OR GLOBAL TABLE
2EEA                             ;			 ELSE REPLACE A WORD ON Z-STACK
2EEA   E5           VARPTS:   PUSH   HL   ;SAVE NEW VALUE
2EEB   CD C6 38               CALL   POPSTK   ;POP OLD WORD OFF Z-STACK
2EEE   E1                     POP   HL   ;RESTORE NEW VALUE
2EEF   C3 AD 38               JP   PSHSTK   ;AND PUSH IT ON TOP OF ZSTACK
2EF2                             ; 
2EF2                             ;************************
2EF2                             ;* PREDICATE PROCESSING *
2EF2                             ;************************
2EF2                             ; 
2EF2                             ; ---------------
2EF2                             ; PREDICATE FAILS
2EF2                             ; ---------------
2EF2   CD DB 38     PREDF:    CALL   NEXTPC   ;FETCH NEXT BYTE OF ZCODE
2EF5   B7                     OR   A   
2EF6   F2 08 2F               JP   P,PREDB   ;BRANCH IF < 128
2EF9   E6 40        PREDNB:   AND   40H   ;CHECK FOR MULTI BYTE HACK
2EFB   CC DB 38               CALL   Z,NEXTPC   ;GET NEXT BYTE IF SO
2EFE   C3 91 2D               JP   MLOOP   ;CONTINUE IN SEQUENCE
2F01                             ; ------------------
2F01                             ; PREDICATE SUCCEEDS
2F01                             ; ------------------
2F01   CD DB 38     PREDS:    CALL   NEXTPC   ;FETCH NEXT BYTE OF ZCODE
2F04   B7                     OR   A   ;IF BIT 7 IS NOT SET
2F05   F2 F9 2E               JP   P,PREDNB   ;BRANCH ON PREDICATE FAILURE
2F08                             ;			 ELSE FALL THROUGH TO PREDB
2F08                             ; ----------------
2F08                             ; PERFORM A BRANCH
2F08                             ; ----------------
2F08   47           PREDB:    LD   B,A   ;SAVE OPCODE
2F09   E6 40                  AND   40H   ;LONG BRANCH?
2F0B   CA 17 2F               JP   Z,PREDLB   ;  YES. (BIT 6 WAS OFF)
2F0E                             ;			   NO. SHORT BRANCH
2F0E   78                     LD   A,B   ;RESTORE OPCODE
2F0F   E6 3F                  AND   3FH   ;FORM SHORT OFFSET
2F11   4F                     LD   C,A   ;USE AS LSB OF BRANCH OFFSET
2F12   06 00                  LD   B,0   ;ZERO MSB OF OFFSET
2F14   C3 2B 2F               JP   PREDB1   ;SIMULATE LONG BRANCH TO A CLOSE PLACE
2F17                             ; 
2F17                             ; HANDLE A LONG BRANCH
2F17   78           PREDLB:   LD   A,B   ;RESTORE OPCODE
2F18   E6 3F                  AND   3FH   ;FORM MSB OF OFFSET
2F1A   47                     LD   B,A   ;B <= MSB OF OFFSET
2F1B   C5                     PUSH   BC   
2F1C   CD DB 38               CALL   NEXTPC   ;GET SECOND BYTE
2F1F   C1                     POP   BC   
2F20   4F                     LD   C,A   ;C <= LSB OF OFFSET
2F21   78                     LD   A,B   ;A <= MSB OF OFFSET
2F22   E6 20                  AND   20H   ;CHECK SIGN OF 14 BIT VALUE
2F24   CA 2B 2F               JP   Z,PREDB1   ;POSITIVE
2F27   78                     LD   A,B   ;ELSE EXTEND THE SIGN (A <= MSB)
2F28   F6 C0                  OR   0C0H   ;AND MAKE THE FULL WORD NEG
2F2A   47                     LD   B,A   ;SAVE THE RESULT IN B
2F2B                             ; 
2F2B                             ; BRANCH TO THE Z-ADDRESS AT $(ZPC) + OFFSET (IN BC)
2F2B                             ; (ZPC  RELATIVE ADDRESSING)
2F2B   78           PREDB1:   LD   A,B   
2F2C   B1                     OR   C   ;IS OFFSET=0?
2F2D   CA 00 30               JP   Z,RFALSE   ;  YES.  DO AN RFALSE
2F30   0B                     DEC   BC   
2F31   78                     LD   A,B   
2F32   B1                     OR   C   ;WAS OFFSET=1
2F33   CA F7 2F               JP   Z,RTRUE   ;  YES.  DO AN RTRUE
2F36   0B           PREDB3:   DEC   BC   ;2 NOW SUBTRACTED FROM JUMP ADDRESS
2F37   60                     LD   H,B   ;HL <= JUMP ADDRESS
2F38   69                     LD   L,C   
2F39   22 4B 3D               LD   (ZPCOFF),HL   ;ZPCOFF <= JUMP ADDRESS
2F3C   2A 27 3D               LD   HL,(ZPCL)   ;HL <= LOW ORDER 9 BITS OF ZIP PROGRAM COUNTER
2F3F   59                     LD   E,C   ;E <= LSB OF JUMP ADDRESS
2F40   78                     LD   A,B   ;A <= MSB OF JUMP ADDRESS
2F41   E6 01                  AND   1   
2F43   57                     LD   D,A   ;ZPCL ADDER
2F44   78                     LD   A,B   ;ARITHMETICALLY SHIFT B RIGHT 1
2F45   07                     RLCA      ;FIRST SET CARRY
2F46   78                     LD   A,B   
2F47   1F                     RRA      
2F48   47                     LD   B,A   ;CUTE
2F49   19                     ADD   HL,DE   
2F4A   7C                     LD   A,H   
2F4B   E6 02                  AND   2   
2F4D   CA 53 2F               JP   Z,PREDB2   ;NO OVERFLOW
2F50   25                     DEC   H   
2F51   25                     DEC   H   ;OVERFLOW
2F52   04                     INC   B   
2F53   22 27 3D     PREDB2:   LD   (ZPCL),HL   ;STORE LOW BYTES
2F56   21 26 3D               LD   HL,ZPCH   ;MODIFY UPPER
2F59   78                     LD   A,B   
2F5A   B7                     OR   A   
2F5B   CA 67 2F               JP   Z,PREDB4   ;NO CHANGE IN PACE, 0DO FASTER JUMP
2F5E   86                     ADD   A,(HL)   
2F5F   77                     LD   (HL),A   
2F60   AF                     XOR   A   
2F61   32 4F 3D               LD   (ZPCFLG),A   ;CHANGED PAGES
2F64   C3 91 2D               JP   MLOOP   ;FINISHED
2F67                             ; 
2F67   2A 4D 3D     PREDB4:   LD   HL,(ZPCPNT)   
2F6A   EB                     EX   DE,HL   
2F6B   2A 4B 3D               LD   HL,(ZPCOFF)   
2F6E   19                     ADD   HL,DE   ;CALCULATE NEW PC POINTER
2F6F   22 4D 3D               LD   (ZPCPNT),HL   
2F72   C3 91 2D               JP   MLOOP   
2F75                             ; 
2F75                             ; **********************************************************************
2F75                             ; *                                                                    *
2F75                             ; *            OPCODE PROCESSING SECTION                               *
2F75                             ; *                                                                    *
2F75                             ; **********************************************************************
2F75                             ; 
2F75                             ; ****************************
2F75                             ; *      DISPATCH TABLES     *
2F75                             ; ****************************
2F75                             ; 
2F75                             ; -----
2F75                             ; 0-OPS
2F75                             ; -----
2F75   F7 2F        OP0T:     DW   RTRUE   ;0
2F77   00 30                  DW   RFALSE   ;1
2F79   06 30                  DW   PRINTI   ;2
2F7B   38 30                  DW   PRINTR   ;3
2F7D   41 30                  DW   ZNOP   ;4
2F7F   44 30                  DW   ZSAVE   ;5
2F81   47 30                  DW   ZRSTOR   ;6
2F83   4A 30                  DW   ZRSTAR   ;7
2F85   4D 30                  DW   RSTACK   ;8
2F87   56 30                  DW   FSTACK   ;9
2F89   5C 30                  DW   ZQUIT   ;10
2F8B   5F 30                  DW   CRLF   ;11
2F8D   65 30                  DW   USL   ;12
2F8F   6B 30                  DW   VERIFY   ;13
2F91                OP0M:     EQU   ($-OP0T)/2   ;NUMBER OF 0-OPS
2F91                             ; 
2F91                             ; -----
2F91                             ; 1-OPS
2F91                             ; -----
2F91   C3 30        OP1T:     DW   ZEROQ   ;0
2F93   CE 30                  DW   NEXTQ   ;1
2F95   DA 30                  DW   FIRSTQ   ;2
2F97   F4 30                  DW   LOC   ;3
2F99   04 31                  DW   PTSIZE   ;4
2F9B   14 31                  DW   INC   ;5
2F9D   1A 31                  DW   DEC   ;6
2F9F   37 31                  DW   PRINTB   ;7
2FA1   40 31                  DW   BADOP   ;8 (UNDEFINED)
2FA3   43 31                  DW   REMOVE   ;9
2FA5   99 31                  DW   PRINTD   ;10
2FA7   B4 31                  DW   RETURN   ;11
2FA9   FF 31                  DW   JUMP   ;12
2FAB   08 32                  DW   PRINT   ;13
2FAD   14 32                  DW   VALUE   ;14
2FAF   1D 32                  DW   BCOM   ;15
2FB1                OP1M:     EQU   ($-OP1T)/2   ;NUMBER OF 1-OPS
2FB1                             ; 
2FB1                             ; -----
2FB1                             ; 2-OPS
2FB1                             ; -----
2FB1   40 31        OP2T:     DW   BADOP   
2FB3   43 34                  DW   EQUALQ   
2FB5   29 32                  DW   LESSQ   
2FB7   36 32                  DW   GRTRQ   
2FB9   42 32                  DW   DLESSQ   
2FBB   4D 32                  DW   IGRTRQ   
2FBD   5D 32                  DW   INQ   
2FBF   71 32                  DW   BTST   
2FC1   83 32                  DW   BOR   
2FC3   8F 32                  DW   BAND   
2FC5   9B 32                  DW   FSETQ   
2FC7   AA 32                  DW   FSET   
2FC9   B7 32                  DW   FCLEAR   
2FCB   C6 32                  DW   ZSET   
2FCD   D2 32                  DW   MOVE   
2FCF   FE 32                  DW   GET   
2FD1   10 33                  DW   GETB   
2FD3   24 33                  DW   GETP   
2FD5   70 33                  DW   GETPT   
2FD7   95 33                  DW   NEXTP   
2FD9   BF 33                  DW   ZADD   
2FDB   C6 33                  DW   ZSUB   
2FDD   D2 33                  DW   MUL   
2FDF   FE 33                  DW   DIV   
2FE1   35 34                  DW   ZMOD   
2FE3                OP2M:     EQU   ($-OP2T)/2   
2FE3                             ; 
2FE3                             ; -----
2FE3                             ; X-OPS
2FE3                             ; -----
2FE3   70 34        OPEXTT:   DW   ZCALL   
2FE5   FC 34                  DW   PUT   
2FE7   15 35                  DW   PUTB   
2FE9   29 35                  DW   PUTP   
2FEB   5B 35                  DW   ZREAD   
2FED   05 37                  DW   PRINTC   
2FEF   0F 37                  DW   PRINTN   
2FF1   4E 37                  DW   RANDOM   
2FF3   5D 37                  DW   ZPUSH   
2FF5   66 37                  DW   ZPOP   
2FF7                OPEXTM:   EQU   ($-OPEXTT)/2   
2FF7                             ; **********************************************************************
2FF7                             ; *                                                                    *
2FF7                             ; *                   ZCODE EXECUTION ROUTINES                         *
2FF7                             ; *                                                                    *
2FF7                             ; **********************************************************************
2FF7                             ; 
2FF7                             ; *******************
2FF7                             ; *      0-OPS      *
2FF7                             ; *******************
2FF7                             ; 
2FF7                             ; 
2FF7                             ; ----------
2FF7                             ; RTRUE [0]
2FF7                             ; ----------
2FF7                             ; SIMULATE A RETURN 1
2FF7   21 01 00     RTRUE:    LD   HL,1   
2FFA   22 3C 3D     RTRUE1:   LD   (ARG1),HL   
2FFD   C3 B4 31               JP   RETURN   
3000                             ; 
3000                             ; -----------
3000                             ; RFALSE [1]
3000                             ; -----------
3000                             ; SIMULATE A RETURN 0
3000   21 00 00     RFALSE:   LD   HL,0   
3003   C3 FA 2F               JP   RTRUE1   
3006                             ; 
3006                             ; -----------
3006                             ; PRINTI [2]
3006                             ; -----------
3006                             ; PRINT THE Z-STRING IMMEDIATELY FOLLOWING THE OPCODE
3006   CD 0C 30     PRINTI:   CALL   PRNTI1   
3009   C3 91 2D               JP   MLOOP   
300C                             ; 
300C   2A 27 3D     PRNTI1:   LD   HL,(ZPCL)   
300F   22 52 3D               LD   (MPCL),HL   ;SET UP MPC TO EQUAL ZPC
3012   3A 26 3D               LD   A,(ZPCH)   
3015   32 51 3D               LD   (MPCH),A   
3018   AF                     XOR   A   
3019   32 56 3D               LD   (MPCFLG),A   ;ZERO MPC FLAG
301C   CD AA 3A               CALL   PZSTR   ;PRINT THE STRING
301F   2A 52 3D               LD   HL,(MPCL)   ;NOW CHANGE BACK ZPC TO END OF STRING
3022   22 27 3D               LD   (ZPCL),HL   
3025   3A 51 3D               LD   A,(MPCH)   
3028   32 26 3D               LD   (ZPCH),A   
302B   3A 56 3D               LD   A,(MPCFLG)   
302E   32 4F 3D               LD   (ZPCFLG),A   ;UPDATE FLAG
3031   2A 54 3D               LD   HL,(MPCPNT)   
3034   22 4D 3D               LD   (ZPCPNT),HL   ;AND PAGE POINTER
3037   C9                     RET      
3038                             ; 
3038                             ; -----------
3038                             ; PRINTR [3]
3038                             ; -----------
3038                             ; EXECUTE A PRINTI, 0FOLLOWED BY A CRLF, 0AND A RTRUE
3038   CD 0C 30     PRINTR:   CALL   PRNTI1   
303B   CD F8 23               CALL   PCRLF   
303E   C3 F7 2F               JP   RTRUE   
3041                             ; 
3041                             ; ---------
3041                             ; ZNOP [4]
3041                             ; ---------
3041                             ; EXECUTE A NOP
3041   C3 91 2D     ZNOP:     JP   MLOOP   
3044                             ; 
3044                             ; ----------
3044                             ; ZSAVE [5]
3044                             ; ----------
3044                             ; SAVE GAME
3044   C3 5C 26     ZSAVE:    JP   SAVE   ;MACHINE DEPENDENT
3047                             ; 
3047                             ; -----------
3047                             ; ZRSTOR [6]
3047                             ; -----------
3047                             ; RESTORE SAVED GAME
3047   C3 C5 26     ZRSTOR:   JP   RESTOR   ;MACHINE DEPENDENT
304A                             ; 
304A                             ; -----------
304A                             ; ZRSTAR [7]
304A                             ; -----------
304A                             ; RESTART GAME
304A   C3 53 26     ZRSTAR:   JP   RESTAR   ;MACHINE DEPENDENT
304D                             ; 
304D                             ; -----------
304D                             ; RSTACK [8]
304D                             ; -----------
304D                             ; EXECUTE A RETURN WITH CALL VALUE ON TOP OF THE STACK
304D   CD C6 38     RSTACK:   CALL   POPSTK   
3050   22 3C 3D               LD   (ARG1),HL   
3053   C3 B4 31               JP   RETURN   
3056                             ; 
3056                             ; -----------
3056                             ; FSTACK [9]
3056                             ; -----------
3056   CD C6 38     FSTACK:   CALL   POPSTK   
3059   C3 91 2D               JP   MLOOP   
305C                             ; 
305C                             ; -----------
305C                             ; ZQUIT [10]
305C                             ; -----------
305C   C3 4C 26     ZQUIT:    JP   QUIT   ;MACHINE DEPENDENT
305F                             ; 
305F                             ; ----------
305F                             ; CRLF [11]
305F                             ; ----------
305F                             ; PRINT CARRIAGE RETURN/LINE FEED
305F   CD F8 23     CRLF:     CALL   PCRLF   
3062   C3 91 2D               JP   MLOOP   
3065                             ; 
3065                             ; ---------
3065                             ; USL [12]
3065                             ; ---------
3065                             ; UPDATE STATUS LINE
3065   CD CA 24     USL:      CALL   WHOLIN   
3068   C3 91 2D               JP   MLOOP   
306B                             ; 
306B                             ; ------------
306B                             ; VERIFY [13]
306B                             ; ------------
306B                             ; VERIFY THE GAME CODE
306B   3E 01        VERIFY:   LD   A,1   ;SELF CHECK
306D   32 39 3D               LD   (VERF),A   ;IN VERIFY MODE, 0ALWAYS GET NEW PAGE
