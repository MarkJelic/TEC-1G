210E                             ; 
210E                             ; *************************************
210E                             ; *        CONFIGURATION DATA         *
210E                             ; *************************************
210E                             ; 
210E   4F           CPMCPL:   DB   79   ;CHARACTERS PER LINE
210F   17           CPMLPP:   DB   23   ;LINES PER PAGE EXCLUDING STATUS LINE
2110                             ; 
2110   01           CPMCLF:   DB   1   ;1 FOR LF AFTER CR ON CONSOLE
2111   00           CPMLLF:   DB   0   ;1 FOR LF AFTER CR ON LIST (NOT USED)
2112   80           CPMINV:   DB   80H   ;NUMBER ADDED TO CHARACTERS FOR INVERSE VIDEO
2113                             ;THE FOLLOWING STRINGS HAVE A COUNT FIELD FOLLOWED BY UP TO 32 CHARACTERS
2113   00           ITRMST:   DB   0   ;INIT TERMINAL
2114                             ;    DS 33-($-ITRMST)
2114   00           RTRMST:   DB   0   ;RESET TERMINAL
2115                             ;    DS 33-($-RTRMST)
2115   00           BSTLIN:   DB   0   ;BEGIN STATUS LINE STRING (NO STATUS LINE)
2116                             ;    DS 33-($-BSTLIN)
2116   00           ESTLIN:   DB   0   ;END STATUS LINE STRING (NO STATUS LINE)
2117                             ;    DS 33-($-ESTLIN)
2117   00           PSTUPS:   DB   0   ;PRINTER SETUP STRING
2118                             ;    DS 33-($-PSTUPS)
2118   00           TWODSK:   DB   0   ;SET TO 1 IF TWO DISKS ARE AVAILABLE
2119                             ; 
2119                             ; TEC-1G: game data filename.  Must match Menu position!
2119   54 45 43 41 44 56 30 31 2E 44 41 54 00 GAMES:   DB   "TECADV01.DAT",0   ;Zork 1
2126   54 45 43 41 44 56 30 32 2E 44 41 54 00 DB   "TECADV02.DAT",0   ;Zork 2
2133   54 45 43 41 44 56 30 33 2E 44 41 54 00 DB   "TECADV03.DAT",0   ;Zork 3
2140   54 45 43 41 44 56 30 36 2E 44 41 54 00 DB   "TECADV06.DAT",0   ;Enchanter
214D   54 45 43 41 44 56 31 34 2E 44 41 54 00 DB   "TECADV14.DAT",0   ;Sorcerer
215A   54 45 43 41 44 56 30 34 2E 44 41 54 00 DB   "TECADV04.DAT",0   ;Spellbreaker
2167   54 45 43 41 44 56 31 31 2E 44 41 54 00 DB   "TECADV11.DAT",0   ;Planetfall
2174   54 45 43 41 44 56 31 32 2E 44 41 54 00 DB   "TECADV12.DAT",0   ;Stationfall
2181   54 45 43 41 44 56 30 35 2E 44 41 54 00 DB   "TECADV05.DAT",0   ;Deadline
218E   54 45 43 41 44 56 30 37 2E 44 41 54 00 DB   "TECADV07.DAT",0   ;HitchHikers
219B   54 45 43 41 44 56 30 38 2E 44 41 54 00 DB   "TECADV08.DAT",0   ;Hijinx
21A8   54 45 43 41 44 56 30 39 2E 44 41 54 00 DB   "TECADV09.DAT",0   ;Infidel
21B5   54 45 43 41 44 56 31 30 2E 44 41 54 00 DB   "TECADV10.DAT",0   ;Leather
21C2   54 45 43 41 44 56 31 33 2E 44 41 54 00 DB   "TECADV13.DAT",0   ;Suspended
21CF                             ; 
21CF                             ; TEC-1G: RAM top memory location address
21CF   00 00        ZORKMT:   DW   0   
21D1   00           ZORKIO:   DB   0   ;Input select flag (1=SERIAL, 0=MATRIX/GLCD)
21D2   00           ZORKGM:   DB   0   ;Game Number
21D3                             ; 
21D3                             ; *************************************
21D3                             ; *           TEC-1G START            *
21D3                             ; *************************************
21D3                             ; 
21D3                CPMSTR:      
21D3   31 26 29               LD   SP,PDL+LPDL   ;INIT MACHINE STACK
21D6   C3 C5 2B               JP   BODY   ;JUMP AROUND SUBROUTINE SECTION
21D9                             ; 
21D9                             ; *************************************
21D9                             ; *            SUBROUTINES            *
21D9                             ; *************************************
21D9                             ; 
21D9   C3 53 26     ZER:      JP   RESTAR   
21DC                             ; 
21DC                             ; ------------------------------------------------------------
21DC                             ; MEMTOP - return top of available memory in HL
21DC                             ; Checks if Expansion RAM is installed, then applies
21DC                             ; alignment logic from original (ensures ZCODE page boundary)
21DC                             ; ------------------------------------------------------------
21DC   2A CF 21     GETTOP:   LD   HL,(ZORKMT)   ;Load top of memory from variable set by MON3
21DF   C3 F1 21               JP   MT1   
21E2   21 00 80     MEMTOP:   LD   HL,TOPRAM   
21E5   36 55                  LD   (HL),55H   ;CHECK IF EXPANSION RAM IS INSTALLED
21E7   7E                     LD   A,(HL)   
21E8   FE 55                  CP   55H   
21EA   2B                     DEC   HL   
21EB   C2 F1 21               JP   NZ,MT1   
21EE   21 FF BF               LD   HL,TOPEXP   
21F1                MT1:         
21F1   22 CF 21               LD   (ZORKMT),HL   ;SAVE TOP OF MEMORY IN VARIABLE
21F4   3A 5B 3D               LD   A,(ZCODEP+1)   ;GET MSB OF LOW MEM STARTING POINTER
21F7   AC                     XOR   H   ; 
21F8   E6 01                  AND   1   ; 
21FA   C0                     RET   NZ   ; 
21FB   25                     DEC   H   ;WASTE 256 MORE IF NECESSARY
21FC   C9                     RET      
21FD                             ; 
21FD                             ; ------------------------------------------------------------
21FD                             ; CHROUT - output character in A to Serial Terminal or GLCD
21FD                             ; Input: A = character to output
21FD                             ; -------------------------------------------------------------
21FD   4F           CHROUT:   LD   C,A   ;Save input
21FE   3A D1 21               LD   A,(ZORKIO)   ;Check input select flag (1=SERIAL, 0=MATRIX/GLCD)
2201   B7                     OR   A   
2202   CA 0A 22               JP   Z,CHROUTMATR   ;If 0, print to MATRIX/GLCD
2205   79                     LD   A,C   ;GET CHARACTER TO PRINT
2206   0E 16                  LD   C,API_TXBYTE   
2208   D7                     RST   10H   ;CALL MON3 API
2209   C9                     RET      
220A                CHROUTMATR:      
220A   3E 18                  LD   A,API_SENDCH   
220C   DF                     RST   18H   ;CALL MON3 API
220D   C9                     RET      
220E                             ; ------------------------------------------------------------
220E                             ; PCSTR - print counted string (count in first byte)
220E                             ; Uses Mon3 txByte API to print characters one at a time
220E                             ; ------------------------------------------------------------
220E   7E           PCSTR:    LD   A,(HL)   ;PRINT STRING, GET COUNT
220F   23           PCSTRL:   INC   HL   ;POINT TO NEXT CHARACTER
2210   B7                     OR   A   
2211   C8                     RET   Z   ;DONE
2212   F5                     PUSH   AF   
2213   C5                     PUSH   BC   
2214   D5                     PUSH   DE   
2215   E5                     PUSH   HL   
2216   7E                     LD   A,(HL)   ;GET CHARACTER TO PRINT
2217   CD FD 21               CALL   CHROUT   ;PRINT CHARACTER IN A
221A   E1                     POP   HL   
221B   D1                     POP   DE   
221C   C1                     POP   BC   
221D   F1                     POP   AF   
221E   3D                     DEC   A   
221F   C3 0F 22               JP   PCSTRL   
2222                             ; PCPST - printer setup string (stubbed, no printer on TEC-1G)
2222   C9           PCPST:    RET      
2223                             ; SETFIL - not needed on TEC-1G (single file)
2223   C9           SETFIL:   RET      
2224                             ; ------------------------------------------------------------
2224                             ; GETDSK - read a 512-byte page from the game data file
2224                             ; TEC-1G version: Byte Block = Page x 512, then disk read into buffer
2224                             ; Input:  A = page number, HL = destination buffer
2224                             ; Output: data read into (HL), 0DBUFP advanced by 512
2224                             ; ------------------------------------------------------------
2224   22 0A 27     GETDSK:   LD   (DBUFP),HL   
2227                             ; Calculate byte offset = page number x 512 (shift left 9)
2227   21 00 00               LD   HL,0   
222A   1E 00                  LD   E,0   
222C   57                     LD   D,A   
222D   CB 22                  SLA   D   
222F   CB 15                  RL   L   
2231                             ; READ SECTOR AT BYTE HLDE
2231   0E 3C                  LD   C,API_DSKRDB   
2233   D7                     RST   10H   
2234                             ; DATA IS PLACED AT 0600-07FF BY MON3, 0COPY TO (HL)
2234   21 00 06               LD   HL,0600H   
2237   ED 5B 0A 27            LD   DE,(DBUFP)   
223B   01 00 02               LD   BC,512   
223E   CD 55 22               CALL   FASTLDIR   
2241                             ;    LDIR
2241                             ; Advance DBUFP by 512
2241   2A 0A 27               LD   HL,(DBUFP)   
2244   11 00 02               LD   DE,512   
2247   19                     ADD   HL,DE   
2248   22 0A 27               LD   (DBUFP),HL   
224B   C9                     RET      
224C   1A           MOVIT:    LD   A,(DE)   ;TRANSFER (D) TO (H) COUNT IN B
224D   77                     LD   (HL),A   
224E   23                     INC   HL   
224F   13                     INC   DE   
2250   05                     DEC   B   
2251   C2 4C 22               JP   NZ,MOVIT   
2254   C9                     RET      
2255                             ; Fast LDIR routine
2255                FASTLDIR:      
2255   E5                     PUSH   HL   
2256   F5                     PUSH   AF   
2257   AF                     XOR   A   
2258   91                     SUB   C   
2259   E6 0F                  AND   15   
225B   87                     ADD   A,A   
225C   C6 66                  ADD   A,FASTLDIR_LOOP & 255   
225E   6F                     LD   L,A   
225F   CE 22                  ADC   A,msb(FASTLDIR_LOOP)   
2261   95                     SUB   L   
2262   67                     LD   H,A   
2263   F1                     POP   AF   
2264   E3                     EX   (SP),HL   
2265   C9                     RET      
2266                FASTLDIR_LOOP:      
2266   ED A0                  LDI      
2268   ED A0                  LDI      
226A   ED A0                  LDI      
226C   ED A0                  LDI      
226E   ED A0                  LDI      
2270   ED A0                  LDI      
2272   ED A0                  LDI      
2274   ED A0                  LDI      
2276   ED A0                  LDI      
2278   ED A0                  LDI      
227A   ED A0                  LDI      
227C   ED A0                  LDI      
227E   ED A0                  LDI      
2280   ED A0                  LDI      
2282   ED A0                  LDI      
2284   ED A0                  LDI      
2286   EA 66 22               JP   PE,FASTLDIR_LOOP   
2289   C9                     RET      
228A   3A 0F 21     READBF:   LD   A,(CPMLPP)   ;LINES PER PAGE
228D   3D                     DEC   A   
228E   32 95 27               LD   (MORCNT),A   
2291   CD 3B 24               CALL   FLSLIN   ;FLUSH LINE
2294   3E 01                  LD   A,1   
2296   32 38 3D               LD   (NOLPT),A   ;TURN OFF LPT DURING READ
2299   16 4D                  LD   D,77   ;D CONTAINS MAX CHARS CAN READ
229B   1E 00                  LD   E,0   ;E CONTAINS CHAR COUNT
229D   2A 3C 3D               LD   HL,(ARG1)   ;READ A BUFFER
22A0   23                     INC   HL   
22A1   CD 70 23     READB1:   CALL   CIN   ;GET A CHAR
22A4   FE 08                  CP   08H   
22A6   CA D9 22               JP   Z,RDBFRO   
22A9   FE 7F                  CP   7FH   
22AB   CA D9 22               JP   Z,RDBFRO   
22AE   FE 0D                  CP   0DH   
22B0   CA F6 22               JP   Z,RDBFCR   
22B3   FE 12                  CP   18   
22B5   CA 34 23               JP   Z,RDBFRT   
22B8   FE 20                  CP   20H   
22BA   DA A1 22               JP   C,READB1   
22BD   4F                     LD   C,A   
22BE   CD FA 23               CALL   COUT   
22C1   79                     LD   A,C   
22C2   FE 41                  CP   "A"   
22C4   DA CE 22               JP   C,READB2   
22C7   FE 5B                  CP   "Z"+1   
22C9   D2 CE 22               JP   NC,READB2   
22CC   C6 20                  ADD   A,"a"-"A"   ;CONVERT TO LOWER CASE
22CE   77           READB2:   LD   (HL),A   
22CF   23                     INC   HL   
22D0   1C                     INC   E   
22D1   7A                     LD   A,D   
22D2   BB                     CP   E   
22D3   CA 50 23               JP   Z,RDBFFL   
22D6   C3 A1 22               JP   READB1   
22D9   7B           RDBFRO:   LD   A,E   ;CHECK IF 1ST CHAR
22DA   FE 00                  CP   0   ;IF SO DON'T DELETE
22DC   CA A1 22               JP   Z,READB1   ;GO GET ANOTHER CHAR
22DF   1D                     DEC   E   
22E0   2B                     DEC   HL   
22E1   CD E7 22               CALL   COUTBS   
22E4   C3 A1 22               JP   READB1   
22E7   0E 08        COUTBS:   LD   C,08H   
22E9   CD FA 23               CALL   COUT   
22EC   0E 20                  LD   C,20H   
22EE   CD FA 23               CALL   COUT   
22F1   0E 08                  LD   C,08H   ;DEVINE RUBOUT
22F3   C3 FA 23               JP   COUT   
22F6   E5           RDBFCR:   PUSH   HL   
22F7   D5                     PUSH   DE   
22F8   AF                     XOR   A   
22F9   32 38 3D               LD   (NOLPT),A   
22FC   2A 5A 3D               LD   HL,(ZCODEP)   
22FF   11 11 00               LD   DE,ZSCRIP+1   
2302   19                     ADD   HL,DE   
2303   7E                     LD   A,(HL)   
2304   E6 01                  AND   1   
2306   CA 25 23               JP   Z,RDBFC2   ;NO LPT
2309   D1                     POP   DE   
230A   D5                     PUSH   DE   
230B   7B                     LD   A,E   
230C   B7                     OR   A   
230D   CA 25 23               JP   Z,RDBFC2   ;NOTHING TYPED
2310   2A 3C 3D               LD   HL,(ARG1)   
2313   23                     INC   HL   
2314   7E           RDBFC3:   LD   A,(HL)   
2315   FE 61                  CP   "a"   
2317   DA 1C 23               JP   C,RDBFC4   ;NOT LOWER CASE
231A   D6 20                  SUB   "a"-"A"   
231C   4F           RDBFC4:   LD   C,A   
231D   23                     INC   HL   
231E   CD C8 24               CALL   LPTO   
2321   1D                     DEC   E   
2322   C2 14 23               JP   NZ,RDBFC3   
2325   D1           RDBFC2:   POP   DE   
2326   E1                     POP   HL   
2327   7A                     LD   A,D   
2328   BB                     CP   E   
2329   CA 2F 23               JP   Z,RDBFC1   
232C   1C                     INC   E   
232D   36 0D                  LD   (HL),0DH   
232F   CD BB 23     RDBFC1:   CALL   PCRLFD   
2332   7B                     LD   A,E   
2333   C9                     RET      
2334   D5           RDBFRT:   PUSH   DE   
2335   E5                     PUSH   HL   
2336   2A 3C 3D               LD   HL,(ARG1)   
2339   23                     INC   HL   
233A   CD BB 23               CALL   PCRLFD   
233D   7B           RDBFR1:   LD   A,E   
233E   B7                     OR   A   
233F   CA 4B 23               JP   Z,RDBFR2   
2342   4E                     LD   C,(HL)   
2343   CD FA 23               CALL   COUT   
2346   1D                     DEC   E   
2347   23                     INC   HL   
2348   C3 3D 23               JP   RDBFR1   
234B   E1           RDBFR2:   POP   HL   
234C   D1                     POP   DE   
234D   C3 A1 22               JP   READB1   
2350   CD 70 23     RDBFFL:   CALL   CIN   
2353   FE 0D                  CP   0DH   ;ACCEPT <RET>
2355   CA F6 22               JP   Z,RDBFCR   
2358   FE 08                  CP   08   ;OR <DEL>
235A   CA D9 22               JP   Z,RDBFRO   
235D   FE 7F                  CP   7FH   
235F   CA D9 22               JP   Z,RDBFRO   
2362   D5                     PUSH   DE   
2363   C5                     PUSH   BC   
2364   E5                     PUSH   HL   
2365   3E 07                  LD   A,7   ;GET CHARACTER TO PRINT
2367   CD FD 21               CALL   CHROUT   ;ECHO CHARACTER
236A   E1                     POP   HL   
236B   C1                     POP   BC   
236C   D1                     POP   DE   
236D   C3 50 23               JP   RDBFFL   ;AND LOOP TIL GET WHAT WE WANT
2370                             ; ------------------------------------------------------------
2370                             ; CIN - read one character from console (blocking)
2370                             ; TEC-1G version: uses API_RXBYTE to read a byte from the terminal
2370                             ; Output: A = character (bit 7 stripped)
2370                             ; ------------------------------------------------------------
2370   C5           CIN:      PUSH   BC   
2371   D5                     PUSH   DE   
2372   E5                     PUSH   HL   
2373   3A D1 21               LD   A,(ZORKIO)   ;Check input select flag (1=SERIAL, 0=MATRIX/GLCD)
2376   B7                     OR   A   
2377   CA 80 23               JP   Z,CIN1   ;If 0, use MATRIX/GLCD input
237A   0E 17                  LD   C,API_RXBYTE   
237C   D7                     RST   10H   ;CALL MON3 API
237D   C3 98 23               JP   CIN2   
2380                CIN1:        
