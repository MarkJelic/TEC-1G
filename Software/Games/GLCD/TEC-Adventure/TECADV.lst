2046   46 52 4F 54 5A 20      DB   "FROTZ "   ; LCD Text
204C   53 65 6C 65 63 74 20 47 61 6D 65 00 DB   "Select Game",0   ; Title
2058   5A 6F 72 6B 20 31 00   DB   "Zork 1",0   
