2D91                             ; **********************************************************************
2D91                             ; *                                                                    *
2D91                             ; *            MAINLOOP                                                *
2D91                             ; *                                                                    *
2D91                             ; **********************************************************************
2D91                             ; 
2D91                             ; 
2D91                             ;MAIN LOOP, READ AN INSTRUCTION AND ITS ARGS, THEN DISPATCH
2D91   AF           MLOOP:    XOR   A   
2D92   32 44 3D               LD   (ARGCNT),A   ;ZERO ARG COUNT
2D95   CD DB 38               CALL   NEXTPC   ;GET NEXT OPCODE IN A
2D98   32 45 3D               LD   (OPCODE),A   ;SAVE IT
2D9B   FE 80                  CP   128   
2D9D   DA 37 2E               JP   C,OP2   ;2-OP
2DA0   FE B0                  CP   176   
2DA2   DA 0E 2E               JP   C,OP1   ;1-OP
2DA5   FE C0                  CP   192   
2DA7   DA 01 2E               JP   C,OP0   ;0-OP
2DAA                             ; 
2DAA                             ; HANDLE AN X-OP
2DAA                             ; 
2DAA   CD DB 38     OPEXT:    CALL   NEXTPC   ;GET VAR TYPES, THIS IS AN EXT OP
2DAD   11 3C 3D               LD   DE,ARG1   
2DB0   06 04                  LD   B,4   ;MAX NUMBER OF ARGS
2DB2   4F                     LD   C,A   
2DB3   C5           OPEXTL:   PUSH   BC   
2DB4   D5                     PUSH   DE   
2DB5   79                     LD   A,C   
2DB6   E6 C0                  AND   0C0H   ;ISOLATE BIT7, 0BIT6 TO DETERMINE ARG TYPE
2DB8   CC 6E 2E               CALL   Z,GETLNG   ;00=LONG IMMEDIATE
2DBB   FE 80                  CP   80H   
2DBD   CC 7B 2E               CALL   Z,GETVAR   ;10=VARIABLE
2DC0   FE 40                  CP   40H   
2DC2   CC 65 2E               CALL   Z,GETSHT   ;01=SHORT IMMEDIATE
2DC5   D1                     POP   DE   
2DC6   C1                     POP   BC   
2DC7   FE C0                  CP   0C0H   ;11=NO MORE VARIABLES
2DC9   CA DE 2D               JP   Z,OPEXTF   ;ALL DONE?
2DCC   EB                     EX   DE,HL   ;NO.  STORE VALUE
2DCD   73                     LD   (HL),E   
2DCE   23                     INC   HL   
2DCF   72                     LD   (HL),D   
2DD0   23                     INC   HL   
2DD1   EB                     EX   DE,HL   ;POINTER BACK IN DE
2DD2   21 44 3D               LD   HL,ARGCNT   
2DD5   34                     INC   (HL)   ;ONE MORE ARG
2DD6   79                     LD   A,C   
2DD7   07                     RLCA      
2DD8   07                     RLCA      ;GET TO NEXT ARG TYPE
2DD9   4F                     LD   C,A   
2DDA   05                     DEC   B   ;DECREMENT ARG COUNT
2DDB   C2 B3 2D               JP   NZ,OPEXTL   ;LOOP FOR MORE
2DDE                             ; 
2DDE                             ; DISPATCH THE X-OP
2DDE                             ; 
2DDE   21 E3 2F     OPEXTF:   LD   HL,OPEXTT   ;COMPUTE DISPATCH POINTER
2DE1   3A 45 3D               LD   A,(OPCODE)   ;RETRIEVE THE OPCODE
2DE4   FE E0                  CP   224   ;IS IT AN EXTENDED 2-OP?
2DE6   DA 58 2E               JP   C,OP2EX   ;  YES.
2DE9   D6 E0                  SUB   224   ;  NO.
2DEB   FE 0A                  CP   OPEXTM   ;IS IT A LEGAL X-OP?
2DED   D2 40 31               JP   NC,BADOP   ;  NO.
2DF0                             ; 
2DF0                             ; GENERALIZED DISPATCH
2DF0                             ; 
2DF0                OPDSPH:      
2DF0   87                     ADD   A,A   ;FORM A WORD OFFSET (*2)
2DF1   4F                     LD   C,A   ;PUT OFFSET INTO BC
2DF2   06 00                  LD   B,0   
