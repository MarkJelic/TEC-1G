0000                             ; 
0000                             ; *************************************
0000                             ; *              EQUATES              *
0000                             ; *************************************
0000                             ; 
0000                             ;--------------------------------------
0000                             ;	SOME COMMON DEFINITIONS
0000                             ;--------------------------------------
0000                             ; 
0000                FALSE:    EQU   00H   ;STANDARD FALSE VALUE
0000                TRUE:     EQU   0FFH   ;STANDARD TRUE VALUE
0000                             ; 
0000                             ;MISC. EQUATES
0000                CPLMAX:   EQU   133   ;MAXIMUM CHARACTERS PER LINE
0000                             ; 
0000                             ;--------------------------------------
0000                             ;	APPLICATION EQUATES
0000                             ;--------------------------------------
0000                             ; 
0000                MAXPGS:   EQU   64   ;MUST BE 64 FOR TRSN VERSIONS
0000                ROOMG:    EQU   16   ;ROOM # (USED TO DISPLAY SHORT DESCRIPTION)
0000                SCOREG:   EQU   17   ;SCORE
0000                MOVESG:   EQU   18   ;NUMBER OF MOVES
0000                ZSTAKL:   EQU   224   ;LENGTH OF THE ZSTACK IN WORDS
0000                             ; 
0000                             ;ZCODE HEADER OFFSETS INIT VALUES
0000                ZVERS:    EQU   0   ;VERSION BYTE
0000                ZSWAP:    EQU   1   ;BIT FLAGS - SEE BELOW
0000                ZID:      EQU   2   ;GAME ID WORD
0000                ZENDLD:   EQU   4   ;START OF NON-PRELOADED ZCODE
0000                ZSTART:   EQU   6   ;ZCODE EXECUTION ADDRESS
0000                ZVOCAB:   EQU   8   ;START OF VOCABULARY TABLE
0000                ZOBJEC:   EQU   10   ;START OF OBJECT TABLE
0000                ZGLOBA:   EQU   12   ;START OF GLOBAL VARIABLE TABLE
0000                ZPURBT:   EQU   14   ;START OF "PURE" ZCODE
0000                ZSCRIP:   EQU   16   ;WORD FLAG FOR CONTROLLING SCRIPT FEATURE
0000                ZSERNM:   EQU   18   ;18 THROUGH 23 ARE ASCII SERIAL NUMBER, UNIQUE TO EACH COPY
0000                ZFWORD:   EQU   24   ;TABLE OF COMMON WORDS
0000                ZCKLEN:   EQU   26   ;LENGTH TO USE FOR CHECKSUM
0000                ZCKSUM:   EQU   28   ;SUM OF ALL WORDS AFTER WORD 64
0000                             ; 
0000                             ;BIT FLAGS IN ZSWAP
0000                ZSWAPF:   EQU   1   ;NOT USED
0000                ZTIMEF:   EQU   2   ;IF SET, 0DISPLAY TIME IN STATUS LINE
0000                ZSPLIT:   EQU   4   ;SET BY MAKDAT TO INDICATE SPLIT FILE
0000                ZTANDY:   EQU   8   ;SET BY INTERPRETER TO DESIGNATE TANDY MACHINE
0000                ZSTATB:   EQU   10H   ;SET BY CPM CONSOLE PROGRAM, 1 IMPLIES NO STATUS LINE
0000                             ;END OF COMMON EQUATES
0000                             ; 
0000                LPDL:     EQU   400   ;200 LEVELS OF PUSH AND POP
0000                             ; 
0000                             ;MON3 EQUATES
0000                API_DSKOPN:   EQU   59   ;OPEN A FILE
0000                API_DSKRDB:   EQU   60   ;READ A BLOCK FROM A FILE
0000                API_SEREBL:   EQU   20   ;ENABLE SERIAL TRANSMISSION
0000                API_TXBYTE:   EQU   22   ;WRITE A BYTE TO A TERMINAL DEVICE
0000                API_RXBYTE:   EQU   23   ;READ A BYTE FROM A TERMINAL DEVICE
0000                API_MATSCN:   EQU   18   ;SCAN MATRIX KEYBOARD
0000                API_MATPAR:   EQU   54   ;PARSE MATRIX SCAN RESULT
0000                API_MENUDR:   EQU   31   ;DRAW A MENU
0000                API_MENUPP:   EQU   47   ;POP A MENU
0000                API_INITGL:   EQU   23   ;INITIALIZE GLCD AT TERMINAL STARTUP
0000                API_SENDCH:   EQU   24   ;SEND A CHARACTER TO GLCD
0000                API_AUTOLF:   EQU   31   ;TOGGLE AUTOMATIC LINE FEED ON GLCD
0000                API_PLOTAW:   EQU   33   ;PLOT ALWAYS TO THE GLCD
0000                API_PLOTSC:   EQU   12   ;PLOT TO GLCD
0000                MENUID:   EQU   0897H   ;MENU SELECTION ID
0000                TOPRAM:   EQU   8000H   ;TOP OF AVAILABLE RAM (USED FOR GAME DATA BUFFER)
0000                TOPEXP:   EQU   0BFFFH   ;TOP OF EXPANDED MEMORY (USED FOR ZCODE)
0000                             ; 
0000                             ; 
0000                             ; *************************************
0000                             ; *                                   *
0000                             ; *           PROGRAM START           *
0000                             ; *                                   *
0000                             ; *************************************
0000                             ; 
